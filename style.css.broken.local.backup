/* Art direction: editorial portfolio for a senior technical writer / knowledge architect
Tone: calm, precise, modern, credible
Palette: warm neutrals + restrained teal accent
Typography: Fraunces for display + Inter for body
Density: spacious, structured, content-led
*/

:root {
  --font-display: "Fraunces", "Georgia", serif;
  --font-body: "Inter", "Helvetica Neue", sans-serif;

  --text-xs: clamp(0.75rem, 0.72rem + 0.15vw, 0.875rem);
  --text-sm: clamp(0.875rem, 0.84rem + 0.2vw, 1rem);
  --text-base: clamp(1rem, 0.97rem + 0.22vw, 1.125rem);
  --text-lg: clamp(1.125rem, 1.05rem + 0.45vw, 1.35rem);
  --text-xl: clamp(1.5rem, 1.2rem + 1vw, 2.2rem);
  --text-2xl: clamp(2rem, 1.45rem + 2vw, 3.35rem);
  --text-3xl: clamp(3rem, 2rem + 4vw, 5.5rem);

  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;
  --space-16: 4rem;
  --space-20: 5rem;
  --space-24: 6rem;
  --space-32: 8rem;

  --color-bg: #f5f3ee;
  --color-surface: #fcfbf8;
  --color-surface-2: #f1eee8;
  --color-surface-3: #ebe7df;
  --color-text: #1f1d19;
  --color-text-muted: #66625b;
  --color-text-faint: #8b867d;
  --color-border: rgba(31, 29, 25, 0.12);
  --color-divider: rgba(31, 29, 25, 0.08);
  --color-primary: #0d6666;
  --color-primary-hover: #0a5050;
  --color-primary-soft: rgba(13, 102, 102, 0.08);
  --color-accent-wash: linear-gradient(135deg, rgba(13, 102, 102, 0.08), rgba(13, 102, 102, 0.02));
  --color-highlight: #dcebea;
  --color-white: #ffffff;

  --radius-sm: 0.4rem;
  --radius-md: 0.75rem;
  --radius-lg: 1.1rem;
  --radius-xl: 1.6rem;
  --radius-pill: 999px;

  --shadow-sm: 0 2px 10px rgba(27, 25, 21, 0.05);
  --shadow-md: 0 10px 28px rgba(27, 25, 21, 0.08);
  --shadow-lg: 0 24px 60px rgba(27, 25, 21, 0.12);

  --content-narrow: 720px;
  --content-default: 1120px;
  --content-wide: 1280px;

  --transition: 180ms cubic-bezier(0.16, 1, 0.3, 1);
  --header-offset: 6.5rem;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  scroll-padding-top: var(--header-offset);
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: 1.65;
  color: var(--color-text);
  background:
    radial-gradient(circle at top left, rgba(13, 102, 102, 0.06), transparent 32%),
    linear-gradient(to bottom, #f7f5f0, var(--color-bg) 18%, var(--color-bg));
}

img,
svg {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
  transition:
    color var(--transition),
    border-color var(--transition),
    background-color var(--transition),
    transform var(--transition),
    box-shadow var(--transition);
}

.hero__lead a,
.section-intro a,
.sample-summary a,
.sample li a,
.case-panel p a,
.case-panel li a,
.case-callout p a,
.case-callout li a,
.case-table td a,
.note-card p a {
  color: var(--color-primary);
  font-weight: 500;
  text-decoration-line: underline;
  text-decoration-thickness: 0.08em;
  text-underline-offset: 0.14em;
  text-decoration-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

.hero__lead a:hover,
.hero__lead a:focus-visible,
.section-intro a:hover,
.section-intro a:focus-visible,
.sample-summary a:hover,
.sample-summary a:focus-visible,
.sample li a:hover,
.sample li a:focus-visible,
.case-panel p a:hover,
.case-panel p a:focus-visible,
.case-panel li a:hover,
.case-panel li a:focus-visible,
.case-callout p a:hover,
.case-callout p a:focus-visible,
.case-callout li a:hover,
.case-callout li a:focus-visible,
.case-table td a:hover,
.case-table td a:focus-visible,
.note-card p a:hover,
.note-card p a:focus-visible {
  color: var(--color-primary-hover);
  text-decoration-color: currentColor;
  background: var(--color-primary-soft);
  border-radius: 0.2rem;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: 0;
  cursor: pointer;
}

:focus-visible {
  outline: 2px solid rgba(13, 102, 102, 0.35);
  outline-offset: 3px;
}

::selection {
  background: rgba(13, 102, 102, 0.16);
}

.container {
  width: min(100% - 2rem, 72rem);
  margin-inline: auto;
}

.container--wide {
  width: min(100% - 2rem, var(--content-wide));
  margin-inline: auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(16px);
  background: rgba(245, 243, 238, 0.8);
  border-bottom: 1px solid var(--color-divider);
}

.site-header__inner {
  width: min(100% - 2rem, var(--content-wide));
  margin-inline: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  min-height: 5.5rem;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: var(--space-4);
  font-size: var(--text-sm);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.brand__mark {
  width: 2.4rem;
  height: 2.4rem;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: rgba(13, 102, 102, 0.08);
  color: var(--color-primary);
  font-weight: 700;
  letter-spacing: 0;
}

.site-nav {
  display: flex;
  align-items: center;
  gap: var(--space-6);
  flex-wrap: wrap;
}

.site-nav a {
  color: var(--color-text-muted);
  font-size: var(--text-sm);
}

.site-nav a:hover,
.site-nav a:focus-visible {
  color: var(--color-text);
}

.page-shell {
  padding-bottom: var(--space-16);
}

.hero {
  padding: clamp(2.25rem, 4vw, 4.25rem) 0 clamp(1.5rem, 2vw, 2.25rem);
}

.hero--tutorial {
  padding-bottom: clamp(1rem, 1.8vw, 1.75rem);
}

.hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
  gap: clamp(1.5rem, 3vw, 2.75rem);
  align-items: start;
}

.hero__copy {
  max-width: 44rem;
}

.eyebrow {
  margin: 0 0 var(--space-4);
  font-size: var(--text-xs);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-text-faint);
}

.hero__title {
  margin: 0;
  font-family: var(--font-display);
  font-size: var(--text-3xl);
  line-height: 0.92;
  letter-spacing: -0.055em;
  text-wrap: balance;
  max-width: 10ch;
}

.hero__lead {
  margin: var(--space-6) 0 0;
  max-width: 34rem;
  font-size: clamp(1.1rem, 1rem + 0.35vw, 1.45rem);
  line-height: 1.55;
  color: var(--color-text-muted);
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-top: var(--space-8);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 3.4rem;
  padding: 0 1.35rem;
  border-radius: var(--radius-pill);
  border: 1px solid transparent;
  font-weight: 600;
  font-size: var(--text-sm);
  white-space: nowrap;
}

.button--primary {
  color: var(--color-white);
  background: var(--color-primary);
  box-shadow: var(--shadow-sm);
}

.button--primary:hover,
.button--primary:focus-visible {
  background: var(--color-primary-hover);
  transform: translateY(-1px);
}

.button--secondary {
  color: var(--color-text);
  background: rgba(255, 255, 255, 0.55);
  border-color: var(--color-border);
}

.button--secondary:hover,
.button--secondary:focus-visible {
  background: var(--color-white);
  border-color: rgba(31, 29, 25, 0.18);
}

.hero-panel {
  align-self: start;
  background: rgba(252, 251, 248, 0.9);
  border: 1px solid rgba(31, 29, 25, 0.08);
  border-radius: var(--radius-xl);
  padding: clamp(1.1rem, 1.6vw, 1.6rem);
  box-shadow: var(--shadow-md);
}

.hero-panel__list {
  display: grid;
  gap: var(--space-5);
}

.hero-panel__item + .hero-panel__item {
  padding-top: var(--space-5);
  border-top: 1px solid var(--color-divider);
}

.hero-panel__label {
  margin: 0 0 var(--space-2);
  font-size: var(--text-xs);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-faint);
}

.hero-panel__title {
  margin: 0 0 0.35rem;
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--color-text);
}

.hero-panel__text {
  margin: 0;
  color: var(--color-text-muted);
}

main {
  display: block;
}

.section {
  padding-block: clamp(1.4rem, 2.3vw, 2.4rem);
}

.section--accent {
  background:
    linear-gradient(180deg, rgba(13, 102, 102, 0.035), rgba(13, 102, 102, 0.015));
}

.section[aria-labelledby="note-heading"] {
  padding-top: 0;
}

.section__header {
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: var(--space-6);
  align-items: end;
  margin-bottom: var(--space-6);
}

.section-kicker {
  margin: 0 0 var(--space-3);
  font-size: var(--text-xs);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-text-faint);
}

.section-title {
  margin: 0;
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  line-height: 0.96;
  letter-spacing: -0.045em;
  text-wrap: balance;
  max-width: 11ch;
}

.section-intro {
  margin: 0;
  max-width: 42rem;
  color: var(--color-text-muted);
}

.section-header {
  display: grid;
  gap: var(--space-4);
}

.section-header .section-title,
.section__header .section-title {
  margin: 0;
}

.section-header .section-intro,
.section__header .section-intro {
  margin: 0;
}

.sample {
  background: rgba(252, 251, 248, 0.64);
  border: 1px solid rgba(31, 29, 25, 0.08);
  border-radius: var(--radius-lg);
  padding: clamp(1.15rem, 1.7vw, 1.6rem);
  box-shadow: var(--shadow-sm);
}

.sample + .sample {
  margin-top: var(--space-5);
}

.sample-header {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
}

.sample-heading h3,
.sample-heading h4 {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-lg);
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.sample-meta {
  margin: 0 0 var(--space-4);
  font-size: var(--text-sm);
  color: var(--color-text-faint);
}

.sample-summary {
  margin: 0 0 var(--space-3);
  max-width: 72ch;
  color: var(--color-text-muted);
}

.code-switcher + .sample-summary,
.code-block + .sample-summary {
  margin-top: var(--space-4);
}

pre,
code,
kbd {
  font-family: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
}

.code-block {
  margin: var(--space-4) 0 var(--space-4);
}

.code-switcher {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.25rem;
  margin-bottom: 0.65rem;
  border-radius: 0.9rem;
  background: rgba(13, 102, 102, 0.06);
  border: 1px solid rgba(13, 102, 102, 0.12);
}

.code-switcher__tab {
  appearance: none;
  border: 1px solid transparent;
  background: transparent;
  color: var(--color-text-muted);
  padding: 0.5rem 0.85rem;
  border-radius: 0.75rem;
  font-size: 0.95rem;
  font-weight: 600;
  line-height: 1;
}

.code-switcher__tab:hover,
.code-switcher__tab:focus-visible {
  color: var(--color-text);
  background: rgba(255, 255, 255, 0.65);
}

.code-switcher__tab.is-active {
  color: var(--color-primary-hover);
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(13, 102, 102, 0.18);
  box-shadow: 0 0 0 1px rgba(13, 102, 102, 0.08);
}

.code-panel {
  display: none;
  margin: 0;
  padding: 1.2rem 1.25rem;
  overflow-x: auto;
  border-radius: 1.15rem;
  background: #11100e;
  color: #f5f3ee;
  font-size: 0.95rem;
  line-height: 1.7;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.code-panel.is-active {
  display: block;
}

.table-wrapper {
  margin: var(--space-4) 0;
  overflow-x: auto;
  border: 1px solid rgba(31, 29, 25, 0.08);
  border-radius: var(--radius-lg);
  background: rgba(252, 251, 248, 0.82);
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  padding: 0.95rem 1rem;
  text-align: left;
  vertical-align: top;
}

th {
  font-size: var(--text-xs);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-faint);
  background: rgba(13, 102, 102, 0.04);
}

td {
  color: var(--color-text-muted);
  border-top: 1px solid rgba(31, 29, 25, 0.08);
}

ol,
ul {
  margin: 0 0 var(--space-4);
  padding-left: 1.35rem;
  color: var(--color-text-muted);
}

li + li {
  margin-top: 0.35rem;
}

.case-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-5);
}

.case-panel,
.case-callout,
.note-card {
  background: rgba(252, 251, 248, 0.7);
  border: 1px solid rgba(31, 29, 25, 0.08);
  border-radius: var(--radius-lg);
  padding: clamp(1.1rem, 1.5vw, 1.45rem);
  box-shadow: var(--shadow-sm);
}

.case-panel h3,
.case-panel h4,
.case-callout h3,
.case-callout h4,
.note-card h3,
.note-card h4 {
  margin: 0 0 var(--space-3);
  font-size: var(--text-lg);
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.case-panel p,
.case-callout p,
.note-card p {
  margin: 0 0 var(--space-3);
  color: var(--color-text-muted);
}

.case-panel p:last-child,
.case-callout p:last-child,
.note-card p:last-child {
  margin-bottom: 0;
}

.case-callout ul {
  margin: var(--space-4) 0 0;
  padding-left: 1.1rem;
  color: var(--color-text-muted);
}

.case-table {
  width: 100%;
}

.note-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-5);
}

.site-footer {
  padding: var(--space-10) 0 var(--space-12);
  border-top: 1px solid var(--color-divider);
}

.site-footer__inner {
  width: min(100% - 2rem, 72rem);
  margin-inline: auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  color: var(--color-text-faint);
  font-size: var(--text-sm);
}

.page-intro,
.page-section {
  padding-block: clamp(2rem, 3vw, 3rem);
}

.page-section--tight {
  padding-block: clamp(1.5rem, 2vw, 2.25rem);
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: var(--space-5);
}

.card {
  grid-column: span 6;
  background: rgba(252, 251, 248, 0.7);
  border: 1px solid rgba(31, 29, 25, 0.08);
  border-radius: var(--radius-xl);
  padding: clamp(1.2rem, 1.6vw, 1.7rem);
  box-shadow: var(--shadow-sm);
}

.card--wide {
  grid-column: span 12;
}

.card__eyebrow {
  margin: 0 0 var(--space-3);
  font-size: var(--text-xs);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-text-faint);
}

.card__title {
  margin: 0 0 var(--space-3);
  font-family: var(--font-display);
  font-size: clamp(1.45rem, 1.1rem + 1vw, 2.1rem);
  line-height: 1;
  letter-spacing: -0.03em;
}

.card__text {
  margin: 0;
  color: var(--color-text-muted);
  max-width: 60ch;
}

.split-layout {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  gap: clamp(1.5rem, 3vw, 3rem);
  align-items: start;
}

.stack {
  display: grid;
  gap: var(--space-4);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 2rem;
  padding: 0 0.7rem;
  border-radius: var(--radius-pill);
  font-size: var(--text-xs);
  letter-spacing: 0.04em;
  background: rgba(13, 102, 102, 0.08);
  color: var(--color-primary-hover);
}

.callout {
  padding: clamp(1rem, 1.5vw, 1.3rem);
  border-radius: var(--radius-lg);
  background: rgba(13, 102, 102, 0.05);
  border: 1px solid rgba(13, 102, 102, 0.12);
}

.callout p:last-child {
  margin-bottom: 0;
}

hr {
  border: 0;
  border-top: 1px solid var(--color-divider);
  margin: var(--space-8) 0;
}

@media (max-width: 1100px) {
  .hero__grid,
  .split-layout,
  .section__header {
    grid-template-columns: 1fr;
  }

  .hero-panel {
    max-width: 34rem;
  }

  .card {
    grid-column: span 12;
  }
}

@media (max-width: 800px) {
  .site-header__inner,
  .site-footer__inner {
    min-height: auto;
    padding-block: 1rem;
  }

  .site-nav {
    gap: var(--space-4);
  }

  .hero {
    padding-top: 1.75rem;
  }

  .hero__title {
    max-width: 12ch;
  }

  .section {
    padding-block: 1.25rem;
  }

  .sample,
  .case-panel,
  .case-callout,
  .note-card,
  .card {
    padding: 1rem;
  }

  .case-grid,
  .note-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .container,
  .container--wide,
  .site-header__inner,
  .site-footer__inner {
    width: min(100% - 1.25rem, 100%);
  }

  .brand {
    gap: 0.75rem;
    font-size: 0.78rem;
  }

  .brand__mark {
    width: 2rem;
    height: 2rem;
  }

  .site-nav {
    gap: 0.9rem 1rem;
  }

  .button {
    width: 100%;
  }

  .hero__actions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .code-switcher {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .code-switcher__tab {
    justify-content: center;
  }

  th,
  td {
    padding: 0.8rem 0.85rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
.skip-link {
  position: absolute;
  left: -9999px;
  top: auto;
  width: 1px;
  height: 1px;
  overflow: hidden;
}

.skip-link:focus,
.skip-link:focus-visible {
  position: fixed;
  left: 1rem;
  top: 1rem;
  width: auto;
  height: auto;
  padding: 0.75rem 1rem;
  border-radius: 0.75rem;
  background: var(--color-surface, #fcfbf8);
  color: var(--color-text, #1f1d19);
  border: 1px solid var(--color-border, rgba(31, 29, 25, 0.12));
  box-shadow: var(--shadow-md, 0 10px 28px rgba(27, 25, 21, 0.08));
  z-index: 200;
}

.site-nav {
  display: flex;
  align-items: center;
  gap: clamp(1rem, 2vw, 2rem);
  flex-wrap: wrap;
}

.site-nav a {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
}

.hero--tutorial {
  padding-bottom: clamp(1rem, 1.8vw, 1.75rem);
}

.section {
  padding-block: clamp(1.4rem, 2.3vw, 2.4rem);
}

.section__header {
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: var(--space-6);
  align-items: end;
  margin-bottom: var(--space-6);
}

.section-title {
  font-size: clamp(2rem, 3.2vw, 3.35rem);
  line-height: 0.96;
  max-width: 11ch;
}

.sample {
  padding: clamp(1.15rem, 1.7vw, 1.6rem);
}

.sample + .sample {
  margin-top: var(--space-5);
}

.sample-summary {
  margin: 0 0 var(--space-3);
}

ol,
ul {
  margin: 0 0 var(--space-4);
  padding-left: 1.35rem;
}

@media (max-width: 1100px) {
  .section__header {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {
  .section {
    padding-block: 1.25rem;
  }

  .sample {
    padding: 1rem;
  }
}
.main-nav {
  display: flex;
  align-items: center;
  gap: clamp(1.25rem, 1.8vw, 2.25rem);
  flex-wrap: wrap;
}

.main-nav a {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.main-nav a:hover,
.main-nav a:focus-visible {
  color: var(--color-text);
}

.hero {
  padding: clamp(2.5rem, 4vw, 4.75rem) 0 clamp(2rem, 3vw, 3.25rem);
}

.hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
  gap: clamp(2rem, 3vw, 4rem);
  align-items: start;
}

.hero h1 {
  margin: 0;
  max-width: 10ch;
  font-family: var(--font-display);
  font-size: clamp(3.75rem, 7vw, 6.6rem);
  line-height: 0.9;
  letter-spacing: -0.06em;
  text-wrap: balance;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 2.4rem;
  margin: 0 0 var(--space-6);
  padding: 0 1rem;
  border-radius: var(--radius-pill);
  background: rgba(13, 102, 102, 0.08);
  color: var(--color-primary);
  font-size: var(--text-sm);
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.hero__lead {
  margin: var(--space-6) 0 0;
  max-width: 34rem;
  font-size: clamp(1.25rem, 1rem + 0.8vw, 1.7rem);
  line-height: 1.6;
  color: var(--color-text-muted);
}

.hero__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  margin-top: var(--space-6);
}

.hero-stat {
  display: inline-flex;
  align-items: center;
  min-height: 2rem;
  padding: 0 0.85rem;
  border-radius: var(--radius-pill);
  background: rgba(31, 29, 25, 0.04);
  color: var(--color-text-faint);
  font-size: var(--text-xs);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  margin-top: var(--space-8);
}

.button-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 3.8rem;
  padding: 0 1.5rem;
  border-radius: var(--radius-pill);
  border: 1px solid transparent;
  font-size: 1.05rem;
  font-weight: 600;
  white-space: nowrap;
  transition:
    color var(--transition),
    background-color var(--transition),
    border-color var(--transition),
    transform var(--transition),
    box-shadow var(--transition);
}

.button-link--primary {
  background: var(--color-primary);
  color: var(--color-white);
  box-shadow: var(--shadow-sm);
}

.button-link--primary:hover,
.button-link--primary:focus-visible {
  background: var(--color-primary-hover);
  transform: translateY(-1px);
}

.button-link--secondary {
  background: rgba(255, 255, 255, 0.72);
  color: var(--color-text);
  border-color: var(--color-border);
}

.button-link--secondary:hover,
.button-link--secondary:focus-visible {
  background: var(--color-white);
  border-color: rgba(31, 29, 25, 0.18);
}

.hero-panel {
  align-self: start;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(31, 29, 25, 0.08);
  border-radius: 2rem;
  padding: clamp(1.5rem, 2vw, 2rem);
  box-shadow: var(--shadow-md);
}

.hero-panel__label {
  margin: 0 0 var(--space-4);
  color: var(--color-text-faint);
  font-size: var(--text-sm);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.proof-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.proof-list li {
  display: grid;
  gap: 0.5rem;
  padding: var(--space-4) 0;
}

.proof-list li + li {
  border-top: 1px solid var(--color-divider);
}

.proof-list strong {
  display: block;
  margin: 0;
  font-size: 1rem;
  line-height: 1.35;
  color: var(--color-text);
}

.proof-list span {
  display: block;
  color: var(--color-text-muted);
  line-height: 1.7;
}

.section {
  padding-block: clamp(1.75rem, 2.6vw, 3rem);
}

.section__header {
  display: grid;
  grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
  gap: var(--space-6);
  align-items: end;
  margin-bottom: var(--space-6);
}

.section-title {
  margin: 0;
  max-width: 10ch;
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 4.3vw, 4.6rem);
  line-height: 0.92;
  letter-spacing: -0.05em;
  text-wrap: balance;
}

.sample-summary {
  margin: 0 0 var(--space-3);
  max-width: 72ch;
  color: var(--color-text-muted);
}

@media (max-width: 1100px) {
  .hero__grid,
  .section__header {
    grid-template-columns: 1fr;
  }

  .hero-panel {
    max-width: 34rem;
  }
}

@media (max-width: 800px) {
  .hero {
    padding: 2rem 0 1.5rem;
  }

  .hero h1 {
    font-size: clamp(2.8rem, 14vw, 4.5rem);
    max-width: 12ch;
  }

  .hero__lead {
    font-size: 1.2rem;
  }

  .hero__actions {
    gap: var(--space-3);
  }

  .button-link {
    min-height: 3.4rem;
    padding-inline: 1.2rem;
    font-size: 1rem;
  }

  .section {
    padding-block: 1.4rem;
  }

  .section-title {
    font-size: clamp(2.2rem, 10vw, 3.2rem);
  }
}

@media (max-width: 560px) {
  .main-nav {
    gap: 0.9rem 1rem;
  }

  .button-link {
    width: 100%;
  }

  .hero__actions {
    display: grid;
    grid-template-columns: 1fr;
  }
}
